  {
    "name": "overloaded_standard",
    "description": "A typical overloaded ticket layout with core info buried and a large history and attachments.",
    "input": {
      "title": "Ticket #12345",
      "sections": [
        {"name": "metadata", "items": [{"key":"id","value":"12345"}]},
        {"name": "attachments", "type": "attachment", "items": [{"filename":"screenshot1.png","preview":"/tmp/1.png"},{"filename":"log.txt","preview":"/tmp/2.png"}]},
        {"name": "activity_feed", "type": "history", "items": ["a","b","c","d","e","f","g"]},
        {"name": "details", "content": {"problem_description": "The app crashes on start", "priority":"high","status":"open"}}
      ]
    },
    "expected": {
      "status": "improved",
      "metrics": {"hierarchy_clarity": 1.0, "collapsed_sections": 1, "has_non_blocking_attachments": true},
      "errors": [],
      "ui_warnings": []
    }
  },

  {
